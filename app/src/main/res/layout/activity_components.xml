<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/AppToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/components_title" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/components_source"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/components_url_et"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="https://…/components.json"
                android:inputType="textUri"
                android:textSize="12sp" />

            <Button
                android:id="@+id/components_save_url_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/components_save_source" />

            <Button
                android:id="@+id/components_check_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/components_check" />

            <Button
                android:id="@+id/components_update_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/components_update_all" />

            <Button
                android:id="@+id/components_import_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/components_import" />

            <Button
                android:id="@+id/components_reset_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/components_reset" />

            <TextView
                android:id="@+id/components_status_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:text="@string/components_idle"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/components_byedpi"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/components_byedpi_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/components_tgws"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/components_tgws_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/components_presets"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/components_presets_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/components_restart_note"
                android:textColor="?android:textColorSecondary"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
